# Agent-Native production/runtime configuration
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
APP_URL=http://localhost:8080

# Agent-Native persistent PostgreSQL database for production.
# Use the Dozer-local Postgres database dedicated to gojolo-dashboard (Buddy/server secret).
# Optional: AGENT_NATIVE_DB_SCHEMA=agent_native (default); runtime URL is search_path-scoped.
DATABASE_URL=

# Optional: local-only auth bypass for development/preview. Do not set in production.
# AUTH_DISABLED=true

# Custom health check message
PING_MESSAGE=pong
